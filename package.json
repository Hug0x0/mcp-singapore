{
  "name": "@hug0x0/mcp-singapore",
  "version": "0.2.0",
  "description": "Singapore public data MCP: data.gov.sg catalog, HDB, weather, transport, SingStat, OneMap and World Bank.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-singapore": "dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE",
    "docs",
    "examples",
    "COVERAGE.md",
    "scripts",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:smoke": "node scripts/smoke-test.mjs",
    "refresh:catalog": "node scripts/refresh-catalog.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "docs:generate": "node scripts/generate-docs.mjs && node scripts/dataset-guides.mjs",
    "docs:check": "node scripts/generate-docs.mjs --check && node scripts/dataset-guides.mjs --check",
    "check:schema": "node scripts/check-schema.mjs",
    "test:package": "node scripts/test-package.mjs",
    "docs:datasets": "node scripts/dataset-guides.mjs"
  },
  "keywords": [
    "mcp",
    "singapore",
    "open-data",
    "hdb",
    "singstat",
    "data-gov-sg"
  ],
  "author": "Hug0x0",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "csv-parse": "^7.0.3",
    "proj4": "^2.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hug0x0/mcp-singapore.git"
  },
  "homepage": "https://github.com/Hug0x0/mcp-singapore#readme",
  "bugs": {
    "url": "https://github.com/Hug0x0/mcp-singapore/issues"
  }
}
